@@ -0,0 +1,28 @@
+# SPDX-License-Identifier: Apache-2.0
+
+# keep first
+board_runner_args(jlink "--device=STM32H723VG" "--speed=4000")
+board_runner_args(openocd --target-handle=_CHIPNAME.cpu0)
+
+# Select OpenOCD debugger interface
+#   cmake -DOPENOCD_INTERFACE=stlink   (default, ST-Link via HLA mode)
+#   cmake -DOPENOCD_INTERFACE=dap-cmsis (CMSIS-DAP / DAPLink)
+if(NOT OPENOCD_INTERFACE)
+  set(OPENOCD_INTERFACE "stlink")
+endif()
+
+if(OPENOCD_INTERFACE STREQUAL "dap-cmsis")
+  board_runner_args(openocd "--config=${BOARD_DIR}/support/openocd_dap.cfg")
+  # Use wrapper script to work around USB/firmware issue with Horco CMSIS-DAP
+  # The wrapper resets the USB device and unbinds cdc_acm before running openocd
+  set(OPENOCD "${BOARD_DIR}/support/openocd-cmsis-dap-wrapper.sh"
+      CACHE FILEPATH "OpenOCD wrapper for CMSIS-DAP" FORCE)
+else()
+  board_runner_args(openocd "--config=${BOARD_DIR}/support/openocd_stlink.cfg")
+  # Reset OPENOCD to system default (not the CMSIS-DAP wrapper)
+  unset(OPENOCD CACHE)
+endif()
+
+# keep first
+include(${ZEPHYR_BASE}/boards/common/openocd-stm32.board.cmake)
+include(${ZEPHYR_BASE}/boards/common/jlink.board.cmake)
