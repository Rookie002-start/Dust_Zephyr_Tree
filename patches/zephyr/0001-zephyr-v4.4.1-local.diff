diff --git a/boards/st/damiao_mc02/board_debug.c b/boards/st/damiao_mc02/board_debug.c
new file mode 100644
index 0000000000000000000000000000000000000000..191ea247c472ee13cb7c77a1ae16404e175e7c4d
--- /dev/null
+++ b/boards/st/damiao_mc02/board_debug.c
@@ -0,0 +1,31 @@
+/*
+ * Damiao MC02 board - debug connectivity fix
+ *
+ * Direct register writes to DBGMCU, no HAL function dependency.
+ * DBGMCU base: 0x5C001000 (STM32H7 D3 domain)
+ * CR offset 0x004:
+ *   bit 22 = D1DBGCKEN (0x00400000)
+ *   bit 21 = D3DBGCKEN (0x00200000)
+ *   bit  1 = DBG_STOP_D1 (0x00000002)
+ *   bit  0 = DBG_SLEEP_D1 (0x00000001)
+ *
+ * Copyright (c) 2024
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <zephyr/init.h>
+
+#define DBGMCU_BASE  0x5C001000UL
+#define DBGMCU_CR    (*(volatile uint32_t *)(DBGMCU_BASE + 0x004))
+
+/* Bits we need: D1 debug clock + D3 debug clock + sleep debug + stop debug */
+#define DBGMCU_CR_NEEDED  (0x00400000U | 0x00200000U | 0x00000002U | 0x00000001U)
+
+static int mc02_debug_init(void)
+{
+	DBGMCU_CR |= DBGMCU_CR_NEEDED;
+	return 0;
+}
+
+/* Priority 2: runs AFTER soc_config.c (PRE_KERNEL_1 prio 1) */
+SYS_INIT(mc02_debug_init, PRE_KERNEL_1, 2);
diff --git a/boards/st/damiao_mc02/damiao_mc02.dts b/boards/st/damiao_mc02/damiao_mc02.dts
new file mode 100644
index 0000000000000000000000000000000000000000..cb1bbbf39ce62a954d97fb80aa226e64d945e0c5
--- /dev/null
+++ b/boards/st/damiao_mc02/damiao_mc02.dts
@@ -0,0 +1,259 @@
+/*
+ * Copyright (c) 2024
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Damiao MC02 board device tree
+ * Based on STM32H723VGT6 (LQFP100, 1MB Flash, 564KB RAM)
+ *
+ * WARNING: Pin assignments below are based on typical STM32H723 configurations
+ * and known MC02 peripheral descriptions. VERIFY against actual schematics!
+ */
+
+/dts-v1/;
+#include <st/h7/stm32h723Xg.dtsi>
+#include <st/h7/stm32h723vgtx-pinctrl.dtsi>
+#include <zephyr/dt-bindings/input/input-event-codes.h>
+
+/ {
+	model = "Damiao MC02 Board (STM32H723VGT6)";
+	compatible = "damiao,mc02";
+
+	chosen {
+		/*
+		 * TODO: Verify console UART pins. MC02 has 3 UARTs.
+		 * Common choices: USART1 on PA9/PA10, USART3 on PB10/PB11
+		 * Using USB CDC ACM for console is also common on this board.
+		 */
+		zephyr,console = &usart1;
+		zephyr,shell-uart = &usart1;
+		zephyr,dtcm = &dtcm;
+		zephyr,sram = &sram0;
+		zephyr,flash = &flash0;
+	};
+
+	leds: leds {
+		compatible = "gpio-leds";
+		/*
+		 * TODO: MC02 has a WS2812 smart LED (not a simple GPIO LED).
+		 * WS2812 needs a timer+DMA for control (e.g., SPI MOSI or TIM PWM).
+		 * This placeholder LED node is for basic GPIO test.
+		 * Verify the actual user LED GPIO pin from schematics.
+		 */
+		user_led: led_0 {
+			gpios = <&gpioc 13 GPIO_ACTIVE_HIGH>;
+			label = "User LED";
+		};
+	};
+
+	gpio_keys {
+		compatible = "gpio-keys";
+		/*
+		 * TODO: MC02 has 2 buttons (reset + user).
+		 * Reset is typically NRST (hardware), user button needs verification.
+		 */
+		user_button: button_0 {
+			label = "User Button";
+			gpios = <&gpioc 14 GPIO_ACTIVE_LOW>;
+			zephyr,code = <INPUT_KEY_0>;
+		};
+	};
+
+	aliases {
+		led0 = &user_led;
+		sw0 = &user_button;
+	};
+};
+
+/*
+ * Clock configuration
+ * HSE = 24MHz crystal → PLL = 480MHz system clock
+ * VCO = 24 / 6 * 120 = 480MHz
+ */
+&clk_lsi {
+	status = "okay";
+};
+
+&clk_hsi48 {
+	status = "okay";
+};
+
+&clk_hse {
+	clock-frequency = <DT_FREQ_M(24)>;
+	status = "okay";
+};
+
+&clk_lse {
+	status = "disabled";
+};
+
+&pll {
+	div-m = <6>;
+	mul-n = <120>;
+	div-p = <1>;
+	div-q = <4>;
+	div-r = <2>;
+	clocks = <&clk_hse>;
+	status = "okay";
+};
+
+&pll2 {
+	div-m = <3>;
+	mul-n = <10>;
+	div-p = <1>;
+	div-q = <1>;
+	div-r = <1>;
+	clocks = <&clk_hse>;
+	status = "okay";
+};
+
+&rcc {
+	clocks = <&pll>;
+	clock-frequency = <DT_FREQ_M(480)>;
+	d1cpre = <1>;
+	hpre = <2>;    /* HCLK: 240 MHz */
+	d1ppre = <2>;  /* APB1: 120 MHz */
+	d2ppre1 = <2>; /* APB2: 120 MHz */
+	d2ppre2 = <2>; /* APB3: 120 MHz */
+	d3ppre = <2>;  /* APB4: 120 MHz */
+};
+
+&pwr {
+	power-supply = "ldo";
+};
+
+/*
+ * Console USART1 - PA9(TX) / PA10(RX)
+ * TODO: Verify console UART pins from schematics.
+ * MC02 has 3 UARTs - which is used for debug console?
+ */
+&usart1 {
+	pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
+	pinctrl-names = "default";
+	current-speed = <115200>;
+	status = "okay";
+};
+
+/*
+ * USART2 - Commonly available on MC02 expansion header
+ * TODO: Verify pin assignment
+ */
+&usart2 {
+	pinctrl-0 = <&usart2_tx_pa2 &usart2_rx_pa3>;
+	pinctrl-names = "default";
+	current-speed = <115200>;
+	status = "disabled";
+};
+
+/*
+ * USART3 - Commonly available on MC02
+ * TODO: Verify pin assignment
+ */
+&usart3 {
+	pinctrl-0 = <&usart3_tx_pb10 &usart3_rx_pb11>;
+	pinctrl-names = "default";
+	current-speed = <115200>;
+	status = "disabled";
+};
+
+&rtc {
+	clocks = <&rcc STM32_CLOCK(APB4, 16)>,
+		 <&rcc STM32_SRC_LSI RTC_SEL(2)>;
+	status = "okay";
+};
+
+/*
+ * I2C1 - Available on MC02 (LCD uses SPI+I2C, BMI088 may use I2C)
+ * TODO: Verify pin assignment
+ */
+&i2c1 {
+	pinctrl-0 = <&i2c1_scl_pb8 &i2c1_sda_pb9>;
+	pinctrl-names = "default";
+	status = "okay";
+	clock-frequency = <I2C_BITRATE_FAST>;
+};
+
+/*
+ * SPI1 - Available on MC02 (BMI088 IMU, LCD, external SPI devices)
+ * TODO: Verify pin assignment for CS pins
+ */
+&spi1 {
+	status = "okay";
+	pinctrl-0 = <&spi1_sck_pa5 &spi1_miso_pa6 &spi1_mosi_pb5>;
+	pinctrl-names = "default";
+	cs-gpios = <&gpioa 4 GPIO_ACTIVE_LOW>; /* TODO: Verify CS pin */
+};
+
+/*
+ * SPI2 - May be used for IMU or external SPI devices
+ * TODO: Verify if used on MC02
+ */
+&spi2 {
+	status = "disabled";
+	pinctrl-0 = <&spi2_sck_pb13 &spi2_miso_pb14 &spi2_mosi_pb15>;
+	pinctrl-names = "default";
+};
+
+/*
+ * CANFD1 - MC02 has 3 CANFD interfaces
+ * TODO: Verify pin assignment for all 3 CANFD interfaces
+ */
+&fdcan1 {
+	pinctrl-0 = <&fdcan1_rx_pd0 &fdcan1_tx_pd1>;
+	pinctrl-names = "default";
+	clocks = <&rcc STM32_CLOCK(APB1_2, 8)>,
+		 <&rcc STM32_SRC_PLL2_Q FDCAN_SEL(2)>;
+	status = "okay";
+};
+
+/*
+ * FDCAN2 - Second CANFD interface
+ * TODO: Verify pin assignment
+ */
+&fdcan2 {
+	pinctrl-0 = <&fdcan2_rx_pb12 &fdcan2_tx_pb13>;
+	pinctrl-names = "default";
+	clocks = <&rcc STM32_CLOCK(APB1_2, 8)>,
+		 <&rcc STM32_SRC_PLL2_Q FDCAN_SEL(2)>;
+	status = "disabled";
+};
+
+/*
+ * USB OTG HS (used as Full-Speed device on MC02)
+ * MC02 has 1 USB interface
+ * TODO: Verify USB pins (DP=PA12, DM=PA11 are standard for FS)
+ */
+zephyr_udc0: &usbotg_hs {
+	pinctrl-0 = <&usb_otg_hs_dm_pa11 &usb_otg_hs_dp_pa12>;
+	pinctrl-names = "default";
+	status = "okay";
+};
+
+&rng {
+	status = "okay";
+};
+
+/*
+ * ADC - Available on MC02
+ * TODO: Configure ADC channels when needed.
+ * Required properties: st,adc-clock-source, st,adc-prescaler,
+ * st,adc-resolutions, sampling-times
+ */
+/* &adc1 { status = "okay"; }; */
+
+/*
+ * PWM / Timers for servo interface (MC02 has 4 PWM outputs)
+ * TODO: Configure timer PWM channels based on actual pin assignments
+ * These are commonly on TIM1/2/3/4/5/8 channels
+ */
+
+/*
+ * QSPI Flash - W25Q64JV (8MB) on MC02
+ * TODO: Configure QUADSPI pins and enable
+ */
+&quadspi {
+	status = "disabled";
+};
+
+&backup_sram {
+	status = "okay";
+};
