--- /dev/null
+++ b/boards/st/damiao_mc02/support/openocd_stlink.cfg
@@ -0,0 +1,37 @@
+# Damiao MC02 board OpenOCD ST-LINK configuration
+#
+# MC02 SWD port: 4-pin (VCC/GND/SWDIO/SWCLK), no NRST.
+# Uses HLA mode (interface/stlink.cfg) - DAP mode has AHB-AP issues
+# on this board when CPU is running.
+#
+# Key fix: stm32h7x.cfg's examine-end handler accesses DBGMCU via AHB-AP
+# while CPU is running, which fails on MC02. We suppress it and set
+# DBGMCU bits in reset-init instead (CPU is halted at that point).
+#
+# Copyright (c) 2024
+# SPDX-License-Identifier: Apache-2.0
+
+source [find interface/stlink.cfg]
+transport select hla_swd
+
+set WORKAREASIZE 0x3000
+set CHIPNAME STM32H723VG
+set BOARDNAME DAMIAO-MC02
+
+source [find target/stm32h7x.cfg]
+
+adapter speed 1000
+
+# Suppress examine-end - DBGMCU access fails on running CPU
+$_CHIPNAME.cpu0 configure -event examine-end {}
+
+# Set DBGMCU bits when CPU is halted (during reset-init)
+$_CHIPNAME.cpu0 configure -event reset-init {
+    # Enable D3 and D1 DBG clocks
+    stm32h7x_dbgmcu_mmw 0x004 0x00600000 0
+    # Enable debug during low power modes D1
+    stm32h7x_dbgmcu_mmw 0x004 0x00000007 0
+    # Enable debug during low power modes D2
+    stm32h7x_dbgmcu_mmw 0x004 0x00000038 0
+    adapter speed 4000
+}
