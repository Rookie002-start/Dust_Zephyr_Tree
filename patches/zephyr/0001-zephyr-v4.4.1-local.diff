+#endif /* CONFIG_ARM_SECURE_FIRMWARE */
+#endif /* CONFIG_ARMV7_M_ARMV8_M_MAINLINE */
+	SVCall_IRQn                   =  -5,
+	DebugMonitor_IRQn             =  -4,
+	PendSV_IRQn                   =  -2,
+	SysTick_IRQn                  =  -1,
+	Max_IRQn                      =  CONFIG_NUM_IRQS,
+} IRQn_Type;
+
+#if defined(CONFIG_CPU_CORTEX_M0)
