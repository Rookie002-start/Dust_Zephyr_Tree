# Custom board for STM32H723VGT6

# Enable MPU
CONFIG_ARM_MPU=y

# Enable HW stack protection
CONFIG_HW_STACK_PROTECTION=y

# Enable UART
CONFIG_SERIAL=y

# Console
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# Enable GPIO
CONFIG_GPIO=y

# Keep debug interface alive during sleep (prevent flash lock-out)
CONFIG_STM32_ENABLE_DEBUG_SLEEP_STOP=y
