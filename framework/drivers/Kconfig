# drivers/Kconfig - 底层硬件驱动抽象
# 提供 GPIO/PWM/UART/CAN 等外设驱动，以及 printk/shell 调试通道
# 每个 config 直接 select 对应的 Zephyr 子系统驱动符号

config DUST_DEV_GPIO_OUTPUT
    default n
    bool "Enable GPIO output wrapper"
    select GPIO
    help
        Enable the GPIO output wrappers in drivers/device/gpio.

config DUST_DEV_GPIO_INPUT
    default n
    bool "Enable GPIO input wrapper"
    select GPIO
    help
        Enable the GPIO input wrappers in drivers/device/gpio.

config DUST_DEV_PWM
    default n
    bool "Enable simple PWM device wrapper"
    select PWM
    help
        Enable the lightweight PWM wrapper in drivers/device/pwm.

config DUST_COM_UART
    default n
    bool "UART interrupt driver"
    select SERIAL
    select UART_INTERRUPT_DRIVEN
    select UART_ASYNC_API
    select DUST_BUF_BIPBUF
    help
        Enable the UART interrupt driver with ping-pong receive buffering.

config DUST_COM_UART_DMA
    default n
    bool "UART DMA driver"
    select SERIAL
    select UART_ASYNC_API
    select DUST_BUF_BIPBUF
    help
        Enable the asynchronous DMA UART driver.

config DUST_COM_SPI
    default n
    bool "SPI driver"
    select SPI
    select GPIO
    help
        Enable the lightweight SPI wrapper in drivers/communication/spi.

config DUST_COM_CAN
    default n
    bool "CAN driver"
    select CAN
    help
        Enable the CAN driver. Board DTS must provide the CAN controller node.

config DUST_COM_RS485
    default n
    bool "RS485 half-duplex driver"
    select SERIAL
    select UART_ASYNC_API
    select GPIO
    help
        Enable the RS485 half-duplex driver using UART_ASYNC_API and a DE/RE GPIO.

config DUST_COM_USB
    default n
    bool "USB CDC ACM driver"
    select DUST_BUF_BIPBUF
    select DUST_USB_DEVICE_STACK
    help
        Enable the C++ USB device CDC ACM stream.

